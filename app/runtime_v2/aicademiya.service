[Unit]
Description=AIcademiya_V2 private teaching application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aicademiya
Group=aicademiya
WorkingDirectory=/opt/aicademiya/current
EnvironmentFile=/etc/aicademiya/aicademiya.conf
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/aicademiya/current/tools/start-linux.sh
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aicademiya

[Install]
WantedBy=multi-user.target
