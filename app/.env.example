# Copy to .env, then set database passwords locally. Never commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Empty AI values use app/config.json.
AICADEMIYA_AI_BASE_URL=
AICADEMIYA_AI_MODEL=
AICADEMIYA_AI_API_KEY=
AICADEMIYA_DEMO_ENABLED=false

# Document processing limits; incomplete input is not used to generate tasks.
AICADEMIYA_DOCUMENT_MAX_UNITS=300
AICADEMIYA_DOCUMENT_MAX_CHARACTERS=300000
AICADEMIYA_DOCUMENT_IMAGE_MAX_EDGE=2000
