# Private deployment: cp .env.example .env; edit locally; never commit .env.
# tools/start-linux.sh loads this shell-compatible file. No auto inference.
AICADEMIYA_AI_PROVIDER=aicademiya-router
AICADEMIYA_AI_MODE=openai
AICADEMIYA_AI_BASE_URL=http://127.0.0.1:18280/v1
AICADEMIYA_AI_MODEL=AIcademiya-64kx3-Qwen3.8-27B
AICADEMIYA_AI_API_KEY=''
AICADEMIYA_DATA_DIR=./data-production
AICADEMIYA_DEMO_ENABLED=false
# true for HTTPS reverse proxy; false only for isolated localhost HTTP smoke.
AICADEMIYA_COOKIE_SECURE=true
AICADEMIYA_ALLOWED_ORIGINS=https://teaching.example.com
AICADEMIYA_WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=''
AICADEMIYA_HOST=127.0.0.1
AICADEMIYA_PORT=18773
